# FWD App Environment Variables
# Add these in Vercel Project Settings > Environment Variables.
# 
# IMPORTANT: Never expose secret keys (service_role, JWT_SECRET) in frontend code.
# Only use public/anon keys in VITE_ prefixed variables.

# Required: Supabase project URL (found in Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=

# Required: Supabase anon/public key (found in Supabase Dashboard > Settings > API)
# This is safe to expose in the browser. Never use the service_role key here.
VITE_SUPABASE_ANON_KEY=

# Required: FWD app public URL (production or local)
VITE_FWD_APP_URL=https://fwd.treytv.com

# Required: Comma-separated list of allowed parent origins for embed/picker
# These are the domains allowed to embed the FWD picker.
# Include localhost for development, remove in production if desired.
VITE_FWD_ALLOWED_PARENT_ORIGINS=https://fwd.treytv.com,https://tv.treytrizzy.com,https://treytv.com,https://www.treytv.com,http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------
# Trey TV OAuth / OIDC (Continue with Trey TV login option)
# ---------------------------------------------------------------

# OIDC Issuer: the Supabase project URL that powers Trey TV auth.
# When set, FWD uses standard Supabase OIDC endpoints:
#   authorize → {ISSUER}/auth/v1/authorize
#   token     → {ISSUER}/auth/v1/token
#   userinfo  → {ISSUER}/auth/v1/user
# The Edge Function also validates the `iss` claim in the returned ID token.
VITE_TREY_TV_OAUTH_ISSUER=https://wcdwlqnfcsuaacbvdmgx.supabase.co

# Fallback custom auth bridge URL (used only if ISSUER is not set).
VITE_TREY_TV_AUTH_URL=https://tv.treytrizzy.com

# Public OAuth client ID issued by Trey TV for the FWD app.
# Safe to expose in the browser.
VITE_TREY_TV_OAUTH_CLIENT_ID=PASTE_CLIENT_ID_FROM_TREY_TV_OAUTH_APP

# Redirect URI registered on the Trey TV OAuth app.
# Must match EXACTLY — including https vs http and no trailing slash.
# Production:
VITE_FWD_TREY_TV_REDIRECT_URI=https://fwd.treytv.com/auth/trey-tv/callback
# Local dev (uncomment and swap when running locally):
# VITE_FWD_TREY_TV_REDIRECT_URI=http://localhost:3000/auth/trey-tv/callback

# NOTE: These must NEVER appear in VITE_* variables (they are server-only):
#   TREY_TV_OAUTH_CLIENT_SECRET   → set via: supabase secrets set TREY_TV_OAUTH_CLIENT_SECRET=...
#   TREY_TV_OAUTH_ISSUER          → set via: supabase secrets set TREY_TV_OAUTH_ISSUER=...
#   TREY_TV_OAUTH_CLIENT_ID       → set via: supabase secrets set TREY_TV_OAUTH_CLIENT_ID=...
