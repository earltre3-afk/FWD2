# FWD App Environment Variables
# Add these in Vercel Project Settings > Environment Variables.
# 
# IMPORTANT: Never expose secret keys (service_role, JWT_SECRET) in frontend code.
# Only use public/anon keys in VITE_ prefixed variables.

# Required: Supabase project URL (found in Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=

# Required: Supabase anon/public key (found in Supabase Dashboard > Settings > API)
# This is safe to expose in the browser. Never use the service_role key here.
VITE_SUPABASE_ANON_KEY=

# Required: FWD app public URL (production or local)
VITE_FWD_APP_URL=https://fwd.treytv.com

# Required: Comma-separated list of allowed parent origins for embed/picker
# These are the domains allowed to embed the FWD picker.
# Include localhost for development, remove in production if desired.
VITE_FWD_ALLOWED_PARENT_ORIGINS=https://fwd.treytv.com,https://tv.treytrizzy.com,https://treytv.com,https://www.treytv.com,http://localhost:3000,http://localhost:5173
